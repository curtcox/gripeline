name: modl-quoted-ids-and-redefinition
mapping: typed
spec: 14
expect: bash
=== modl ===
white                                  # a lone color word is the background
"first step" square echo start
"first step" big blue                  # redefinition keeps shape and text
"second step" circle wc -c
#gl node "first step" role=program
#gl node out role=file append=true
out hex result.txt
"first step" -> "second step" -> out
=== bash ===
echo start | wc -c >> result.txt
